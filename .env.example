# Copy this to .env and fill in values
# LOCAL only — Cloud Run does not use this file

GCP_PROJECT_ID=your-gcp-project-id
GCP_KEY_FILE=./service-account-key.json
BQ_DATASET=decode_tracker
BQ_TABLE=daily_log
PORT=3000

# Access token — set any string you want (e.g. "mypassword123")
# If left empty, the app runs without auth (dev mode only)
# Required in production — set this in Cloud Run env vars too
APP_SECRET=your-secret-token-here
